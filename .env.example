# Server-side keys (never shipped to the browser)
GEMINI_API_KEY=
GRADIUM_API_KEY=
# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.8-flash

# Browser key for the Google Maps JavaScript API (+ Geocoding API, optional).
# Restrict it to http://localhost:5173/* in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Animated story ("Watch it"): Nano Banana keyframes + Gemini Omni Flash clips
# IMAGE_MODEL=gemini-nano-banana-2.1
# VIDEO_MODEL=gemini-omni-1.1-flash
# ENABLE_VIDEO=true          # false = painted stills with camera motion only (cheaper, faster)
# VIDEO_CONCURRENCY=3
